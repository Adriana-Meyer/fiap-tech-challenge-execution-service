# Template de referência — NÃO é aplicado diretamente.
# O Secret real é criado via `kubectl create secret generic`
# (deploy-aws.yml), com os valores vindos dos GitHub Secrets
# (JWT_SECRET, NEW_RELIC_LICENSE_KEY), nunca commitado com valores reais.
# Não há secret de banco: o DynamoDB é acessado pela role IAM do node.
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: execution
type: Opaque
stringData:
  JWT_SECRET: CHANGE_ME
  NEW_RELIC_LICENSE_KEY: CHANGE_ME
